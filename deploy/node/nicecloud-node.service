[Unit]
Description=NiceCloud managed proxy node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nicecloud-node
Group=nicecloud-node
UMask=0077
StateDirectory=nicecloud-node
StateDirectoryMode=0700
WorkingDirectory=/var/lib/nicecloud-node
ExecStart=/opt/nicecloud-node/bin/node-agent -config /etc/nicecloud-node/config.json
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=8
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nicecloud-node
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
