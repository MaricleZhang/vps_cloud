# For systemd EnvironmentFile; set the real external HTTPS URL.
PUBLIC_URL=https://panel.example.com
ALLOWED_ORIGINS=https://panel.example.com
COOKIE_SECURE=1
WEB_DIST=/opt/nicecloud-center/web

# First production startup only. Use a unique password of at least 12 characters.
# Remove the password and restart after the administrator has been initialized.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
